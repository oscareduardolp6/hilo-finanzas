# Config del proyecto de Firebase (ver "Configurar tu propio proyecto de
# Firebase" en README.md). No son valores secretos, pero igual no van al
# repo — copia este archivo a .env.local (ya cubierto por *.local en
# .gitignore) y pon ahí los valores reales de tu proyecto.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
